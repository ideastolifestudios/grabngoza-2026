# Google Ecosystem Integration - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development

# ============================================================================
# GOOGLE WORKSPACE CONFIGURATION
# ============================================================================

# Service account JSON (complete JSON string)
# Get from: Google Cloud Console → Service Accounts → Keys → Create JSON Key
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"grabngoza-google-ecosystem","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"grabngoza-workspace-service@grabngoza-google-ecosystem.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":""}'

# Your Google Workspace domain
# Example: yourbusiness.com
GOOGLE_WORKSPACE_DOMAIN=yourdomain.com

# Admin email in your Google Workspace
# Get from: Google Admin Console → Users → Find Super Admin
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@yourdomain.com

# ============================================================================
# GOOGLE BUSINESS CONFIGURATION
# ============================================================================

# Service account JSON for business APIs
# Get from: Google Cloud Console → Service Accounts → Keys → Create JSON Key
GOOGLE_BUSINESS_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"grabngoza-google-ecosystem","private_key_id":"xxx",...}'

# Google Merchant Center ID
# Get from: Google Merchant Center → Settings → Business Information
GOOGLE_MERCHANT_CENTER_ID=123456789

# Google Analytics Property ID
# Get from: Google Analytics 4 → Admin → Property Settings
GOOGLE_ANALYTICS_PROPERTY_ID=GA-XXXXXXXXX-X

# Google Analytics API Secret
# Get from: Google Analytics 4 → Admin → Data Streams → Web → Measurement Protocol API Secrets
GOOGLE_ANALYTICS_API_SECRET=xxxxx_secret_xxxxx

# Google Search Console Property URL
# Get from: Google Search Console → Select Property
GOOGLE_SEARCH_CONSOLE_PROPERTY=https://yourdomain.com

# Google Business Profile ID
# Get from: Google Business Profile → Settings → Info → Profile ID
GOOGLE_BUSINESS_PROFILE_ID=123456789

# Google Business Account ID
# Get from: Google Business Profile → Settings
GOOGLE_BUSINESS_ACCOUNT_ID=123456789

# Google Business Location ID
# Get from: Google Business Profile → Settings → Location ID
GOOGLE_BUSINESS_LOCATION_ID=123456789

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/grabngoza

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_AUTH_TOKEN=your_sentry_token
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_ENVIRONMENT=development

# ============================================================================
# INTEGRATION TEST CONFIGURATION
# ============================================================================

# Set to true to run integration tests
RUN_INTEGRATION_TESTS=false

# Test timeout (milliseconds)
TEST_TIMEOUT=30000

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit .env.local to version control
# 2. Keep .env.local in .gitignore
# 3. Use .env.example as a template for new developers
# 4. All JSON strings should be properly escaped
# 5. For local development, you can use .env.local
# 6. For production, set environment variables in your hosting platform